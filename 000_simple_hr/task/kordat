      _m = _ch(_i);
      _dzFullCh=0.;_dhFullCh=0.;_vFullCh=0.
      PRINT '- CH',_m;
      PRINT 'Cl','----- DZ ------','----- DH ------','----- V -------',
        '----- PR ------';
      DO _j=1,N.CH(_m);
        _dzFullCh = _dzFullCh + DZ.CH(_m)(_j);
        _dhFullCh = _dhFullCh + DH.CH(_m)(_j);
        _vFullCh = _vFullCh + V.CH(_m)(_j);
        PRINT _j,DZ.CH(_m)(_j),DH.CH(_m)(_j),V.CH(_m)(_j),PR.CH(_m)(_j);
      ENDDO
      PRINT 'Cl','----- S -------','----- D -------','---- Type -----',
