EVENT _DtHandle
  TYPE = 0;
  REPLACE = 1;
  TURN_ON = 1;
  IF (TAU>0.) THEN
    dt_max = 0.01;
  ENDIF
  IF (TAU>0.)&(TAU<=3.) THEN
    dt_max = 0.01;
    dt_out = 0.1;
    ! dt_sav = 10.;
    dt_diag = 10.;
  ENDIF
  IF (TAU>3.) THEN
    dt_max = 0.01;
    dt_out = 1.;
    ! dt_sav = 10.;
    dt_diag = 10.;
  ENDIF
  
END
EVENT _Actions
  TYPE = 0;
  REPLACE = 1;
  TURN_ON = 1;
  IF (TAU>1.)&(TAU<5.) THEN 
    P.BVOL_T1 = MIN(1.1*_MPa,P.BVOL_T1+0.05*_MPa*DT);
  ENDIF
  IF( (TAU>0.) ) THEN
    CALL _Monitor(0.5);
  ENDIF
END

