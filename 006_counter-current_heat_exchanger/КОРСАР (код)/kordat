!!bb Ключи основной процедуры

! Ключ      
restart = 0;                                                     ! проведение расчета с нуля (новая задача)
title = 'VD.035.004 counter current heat exchange';              ! заголовок файла: номер версии и комментарии
dt_max = 0.001;                                                  ! максимальный шаг интегрирования по времени, с
dt_out = 0.1;                                                    ! интервал вывода в файл результатов расчета, с        
fin_tim = 50;                                                    ! конечное время расчета задачи, с.
dt_sav = 0;                                                      ! интервал вывода в файл сохранения состояния задачи, с (при 0 вывод в файл сохранения состоянии задачи отключается)             
append_res = 1;                                                  ! признак дополнения списка вывода, запомненного в файле сохранения состояния задачи
append_sav = 0;                                                  ! признак режима заполнения файла сохранения состояния задачи (при 0 циклическая регистрация)        
check_only = 0;                                                  ! признак установки различных режимов проверки файла входных данных
local_err = 1.0e-4;                                              ! локальная относительная ошибка для численных методов (повышение точности ведет к увеличению времени задачи)
ngas = 'H2O';                                                    ! компонентный состав газовой фазы (для двухфазных потоков)
dt_diag = dt_out;                                                ! интервал вывода статической информации в файл листинга задачи = dt_out (выше), c
inf = 11;                                                        ! признак для управления выводом информации в файл листинга задачи
accel_stat = 1;                                                  ! признак включения режима ускоренного выхода в статическое состояние (при 0 режим отключен)
nwsp_dat = 'nwsp_dat';                                           ! имя файла свойств воды и водяного пара
_tauRest = 0.; ! момент рестарта
_debug = 0; ! вывод отладочной информации
_diag = 0;  ! режим вывода диагностики
            ! 0 - нет диагностики
            ! 1 - краткая
            ! 2 - расширенная
_monPer = 5.0;    ! Период вывода диагностики в файл мониторинга
!!eb

!!bb Общие глобальные переменные
! Константы
_t0C = 273.15;
_tOffset = _t0C;
_pi = 3.1415927;
_gg = 9.81;
_pAtm = 101.3e+03;
_tAtm = 20.+_tOffset;
_tsAtm = WS1P1(1,'P',_pAtm,2);
_kgs = 98066.5;  ! кгс/см2, Па
_MPa = 1.e6; ! МПа, Па 
_kPa = 1.e3; ! МПа, Па
_MWt = 1.e6; ! МПа, Па
_kWt = 1.e3; ! МПа, Па
_atm = 101325.; ! атм, Па
_bar = 1.e5; ! бар, Па
!!eb

!!bb Начальные условия (геометрия и параметры среды)
Nt = 20;         ! число одинаковых труб
Lt = 3.;         ! рабочая длина
di = 0.01;       ! внутренний диаметр трубы
dout = 0.012;    ! наружный диаметр трубы
Ds = 0.08;       ! внутренний диаметр кожуха Ds 
Pout = 1.0*_MPa; ! давление на выходе каждого тракта
Thin = 95.+_t0C; ! температура на входе (горячий канал)
Tcin = 20.+_t0C; ! температура на входе (холодный канал)
Gh = 1;          ! массовый расход (горячий канал)
Gc = 1;          ! массовый расход (горячий канал)

N1 = 10;         ! количество элементарных ячеек
!!eb

MAIN:

LAYOUT ! нодализационная схема (связи между элементами)
CH1/i - BVOL_T1;               ! "вход" горячего канала - в граничную ячейку (противоток)
CH1/o - BLJUN1;                ! "выход" канала заглушен
CH1(N1) - SMASS_T1;            ! источник массы подает расход в N1-ую ячейку (противоток)

CH2/i - BLJUN2;                ! вход канала заглушен
CH2(1) - SMASS_T2;             ! источник массы подает расход в 1-ую ячейку
CH2/o - BVOL_T2;               ! выход горячего канала - в граничную ячейку

CH1(1:N1) - HCS1(1:N1)/1;      ! связь горячего канала со стенкой (противоток, внутренняя поверхность)
CH2(1:N1) - HCS1(1:N1)/2;      ! связь холодного канала со стенкой (наружняя стенка)
END

CALL CH1;                      ! CALL - оператор вызова процедур DATA для всех элементов нодализационной схемы
CALL CH2; 
CALL HCS1;
CALL SMASS_T1;
CALL SMASS_T2;
CALL BVOL_T1;
CALL BVOL_T2;
CALL BLJUN1;
CALL BLJUN2;

SET CALC;                      ! установки процедур EVENT

OUT _Out;

END

!Задание параметров элементов
DATA CH1 ! горячий канал (внутри труб)
	N = N1;                       ! количество расчетных ячеек
	S = Nt*_pi*(di**2)/4;         ! площадь проходного сечения
	TYPE = 0;                     ! тип (круглая труба)
	PR = Nt*_pi*di;               ! смоченный периметр
	DZ = Lt/N1;                   ! длина расчетной ячейки
	DH = 0.;                      ! перепад высоты
	P = Pout;                     ! давление в расчетной ячейке
	T(1,1:N) = Thin;              ! начальная температура жидкости
	T(2,1:N) = WS1P1(2,'P',Pout,2);! начальная температура газа
	VOID = 0.0;                   ! паросодержание (однофазный поток)
END

DATA CH2 ! холодный канал (межтрубное пространство)
	N = N1;                       ! количество расчетных ячеек
	S = _pi*(Ds**2-Nt*dout**2)/4; ! площадь межтрубного пространства
	TYPE = 0;                     ! тип
	PR = _pi*Ds+Nt*_pi*dout;      ! смоченный периметр межтрубного пространства
	DZ = Lt/N1;                   ! длина расчетной ячейки
	DH = 0.;                      ! перепад высоты
	P = Pout;                     ! давление в расчетной ячейке
	T(1,1:N) = Tcin;              ! начальная температура жидкости
	T(2,1:N) = WS1P1(2,'P',Pout,2);! начальная температура газа
	VOID = 0.0;                   ! паросодержание (однофазный поток)
END

DATA HCS1
	N = N1;                         ! количество расчетных ячеек по длине
	KL = 1;                         ! количество слоев с различными свойствами
	K = 5;                          ! количество расчетных узлов по толщине
	NL = 5;                         ! Количество точек в табличной аппроксимации зависимости коэффициента теплопроводности материалов слоев от температуры
	NC = 5;                         ! Количество точек в табличной аппроксимации зависимости произведения коэффициента теплоемкости на плотность материалов слоев от температуры
	TYPE = 0;                       ! тип модели (одномерная модель)
	COOR = 1;                       ! признак системы координат (цилиндрическая)
	XL(1) = di/2;                   ! координаты границ слоев
	XL(2) = dout/2;
	X(1:K) = LINA(XL(1),XL(2),K);   ! координаты расчетных услов
	DFZ = Lt/N1;                    ! длина расчетных ячеек
	B = Nt;                         ! коэффициент увеличения площади теплообмена
	! Сталь 12Х1МФ
	LAM(1:NL,1:KL) = 44., 44., 42., 40., 37.;              ! Табличная аппроксимация зависимости коэффициента теплопроводности материалов от температуры
	CR(1:NC,1:KL) = 3.42e5, 3.41e5, 3.24e5, 3.07e5, 2.83e5;! Табличная аппроксимация зависимости произведения коэффициента теплоемкости на плотность материалов от температуры
	TL(1:NL) = 373.15, 473.15, 573.15, 673.15, 773.15;     ! Значения температуры в табличной аппроксимации зависимости коэффициента теплопроводности материалов слоев от температуры
	TC(1:NC) = 373.15, 473.15, 573.15, 673.15, 773.15;     ! Значения температуры в табличной аппроксимации зависимости произведения коэффициента теплоемкости на плотность материалов слоев от температуры
END

DATA SMASS_T1
	GIN(1) = Gh;                                          !расход жидкости
	GIN(2) = 0;                                           !расход газа
	EHIN(1) = WS2P1(1,'PT',Pout,Thin,4);                  !энтальпии фаз, поступающих в РЯ;
	EHIN(2) = WS1P1(2,'P',Pout,4);
	GMOUT = 0;                                            !расход смеси, покидающей РЯ;
END

DATA SMASS_T2
	GIN(1) = Gc;                                          !расход жидкости
	GIN(2) = 0;                                           !расход газа
	EHIN(1) = WS2P1(1,'PT',Pout,Tcin,4);                  !энтальпии фаз, поступающих в РЯ;
	EHIN(2) = WS1P1(2,'P',Pout,4);
	GMOUT = 0;                                            !расход смеси, покидающей РЯ;
END

DATA BVOL_T1
	P = Pout;
	VOID = 0.0;
	T(1) = Thin;
	T(2) = WS1P1(2,'P',Pout,2);  
END

DATA BVOL_T2
	P = Pout;
	VOID = 0.0;
	T(1) = Tcin;
	T(2) = WS1P1(2,'P',Pout,2);  
END

DATA BLJUN1
	TYPE = 0;            ! признак, определющий направления течения фаз (0 - газ и жидкость параллельно)
END

DATA BLJUN2
	TYPE = 0;            ! признак, определющий направления течения фаз (0 - газ и жидкость параллельно)
END

EVENT CALC
END

OUTPUT _Out              ! Вывод параметров
  WRITE T.CH1(1,1:N1), T.CH2(1,1:N1),
  TW.HCS1(1,1:N1), TW.HCS1(2,1:N1),
  ALW.HCS1(1,1:N1), ALW.HCS1(2,1:N1);
END